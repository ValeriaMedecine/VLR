 const K=[["إجمالي الأكواد",S.length],["اشتراك فعّال",act.length],["منتهٍ",S.length-act.length],["لم يدخلوا بعد",S.filter(s=>!(s.devices||[]).length).length],["نشطون اليوم",S.filter(s=>s.lastSeen===t).length],["إجمالي الأجهزة",S.reduce((n,s)=>n+(s.devices||[]).length,0)],["ينتهون خلال 7 أيام",act.filter(s=>left(s.end)<=7).length],["اختاروا تخصصهم",S.filter(s=>s.spec!=null).length],["تخصصات مضافة",Object.keys(SPN).length]];
