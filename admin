let SPL=[],IMD=null;const IMS={courses:0,summaries:1,media:2,sites:3,books:4,exercises:5,institutions:7};
function mergeLinks(arr,L){const n={f:0,l:0,d:0};let id=Date.now();const nid=()=>++id,fold=(pid,name)=>{const f=arr.find(x=>x.k=="f"&&x.p==pid&&x.t==name);if(f)return f.id;const o={id:nid(),p:pid,k:"f",t:name};arr.push(o);n.f++;return o.id};
 L.forEach(x=>{let pid=-1;(x.path||[]).forEach(nm=>{pid=fold(pid,String(nm))});if(x.kind!="l"||!x.url)return;const t=x.title||x.url;if(arr.some(z=>z.k=="l"&&z.p==pid&&z.u==x.url&&z.t==t)){n.d++;return}arr.push({id:nid(),p:pid,k:"l",t,u:x.url});n.l++});return n}
