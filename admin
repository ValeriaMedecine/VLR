$("#imb").onclick=async()=>{if(!IMD||!$("#imt").value)return;if(!confirm("استيراد "+IMD.items.length+" عنصر إلى التخصص المختار؟ لا يُحذف شيء ويُتجاهل المكرر."))return;
 const[fc,sp]=$("#imt").value.split("|"),by={};IMD.items.forEach(x=>{const k=IMS[x.s];if(k!=null)(by[k]=by[k]||[]).push(x)});const skip=IMD.items.filter(x=>IMS[x.s]==null).length,tot={f:0,l:0,d:0};$("#imb").disabled=true;$("#imp").textContent="جارٍ الاستيراد…";
 try{for(const[k,L]of Object.entries(by)){const ref=doc(db,"areas",`f${fc}y${sp}s${k}`);const r=await runTransaction(db,async t=>{const g=await t.get(ref),arr=g.exists()?JSON.parse(g.data().j||"[]"):[],n=mergeLinks(arr,L),j=JSON.stringify(arr);if(j.length>9e5)throw new Error("حجم القسم كبير جدًا (حد 1 MiB)");t.set(ref,{v:(g.exists()?g.data().v:0)+1,j});return n});tot.f+=r.f;tot.l+=r.l;tot.d+=r.d}
 $("#imp").textContent=`تم: ${tot.f} مجلد، ${tot.l} رابط، وتُجوهل ${tot.d} مكرر`+(skip?`، و${skip} عنصر من أقسام غير مدعومة`:"");msg("اكتمل الاستيراد")}catch(e){$("#imp").textContent="";msg(why(e))}$("#imb").disabled=false};
const IMR=Object.fromEntries(Object.entries(IMS).map(([k,v])=>[v,k])),IMA={courses:"دروس",summaries:"ملخصات",media:"ميديا",sites:"مواقع",books:"كتب",exercises:"تمارين واختبارات",institutions:"مؤسسات"};
function buildLib(A,fc,sp,name){const items=[],counts={};for(const[k,arr]of Object.entries(A)){const sn=IMR[k];if(!sn)continue;const nm=id=>{const o=[];let c=arr.find(x=>x.id==id&&x.k=="f");while(c){o.unshift(c.t);c=arr.find(x=>x.id==c.p&&x.k=="f")}return o};
 arr.forEach(x=>{if(x.k=="f")items.push({sec:"M",kind:"f",path:nm(x.id),s:sn});else if(x.k=="l"){items.push({sec:"M",kind:"l",path:nm(x.p),title:x.t,url:x.u,mtype:"lnk",s:sn});counts[IMA[sn]]=(counts[IMA[sn]]||0)+1}})}
